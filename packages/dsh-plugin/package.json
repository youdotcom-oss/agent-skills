{
  "name": "@youdotcom-oss/dsh-plugin",
  "version": "0.0.0",
  "description": "You.com agent skill provider and MCP setup for DeepSeek Harness (dsh), registered via ctx.skills",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youdotcom-oss/agent-skills.git",
    "directory": "packages/dsh-plugin"
  },
  "author": {
    "name": "You.com",
    "email": "support@you.com",
    "url": "https://you.com"
  },
  "keywords": [
    "you.com",
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "skill",
    "skills",
    "ctx.skills",
    "mcp",
    "web-search",
    "research"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "skills",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts && tsc -b tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "types": "./lib/types/index.d.ts",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.5-rc.2",
    "@types/bun": "1.4.2",
    "@types/node": "^22.20.3"
  }
}
