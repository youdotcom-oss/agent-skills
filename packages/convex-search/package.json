{
  "name": "@youdotcom-oss/convex-search",
  "version": "0.1.0",
  "description": "A Convex component for You.com web search, with keyless access by default, cached results, reactive queries, and a tool for @convex-dev/agent.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youdotcom-oss/agent-skills.git",
    "directory": "packages/convex-search"
  },
  "bugs": {
    "url": "https://github.com/youdotcom-oss/agent-skills/issues"
  },
  "homepage": "https://github.com/youdotcom-oss/agent-skills/tree/main/packages/convex-search#readme",
  "author": {
    "name": "You.com",
    "email": "support@you.com",
    "url": "https://you.com"
  },
  "keywords": [
    "convex",
    "component",
    "you.com",
    "search",
    "web-search",
    "ai",
    "agent",
    "cache"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "module": "./dist/client/index.js",
  "files": [
    "dist",
    "src",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc6 --project ./tsconfig.build.json",
    "check": "tsc6 --noEmit && tsc6 -p example && tsc6 -p example/convex && eslint .",
    "codegen": "convex codegen --component-dir ./src/component",
    "dev": "convex dev",
    "dev:frontend": "cd example && vite",
    "test": "vitest run --typecheck",
    "test:live": "YOU_LIVE=1 vitest run src/component/youApi.live.test.ts"
  },
  "peerDependenciesMeta": {
    "@convex-dev/agent": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "types": "./dist/client/index.d.ts",
  "peerDependencies": {
    "@convex-dev/agent": "^0.7.0",
    "convex": "^1.43.0",
    "zod": "^3.25.0 || ^4.0.0",
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.111",
    "@convex-dev/agent": "^0.7.9",
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "9.39.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ai": "^7.0.166",
    "convex": "^1.44.0",
    "convex-test": "0.0.61",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.4",
    "vitest": "4.1.11",
    "zod": "^4.6.7"
  }
}
